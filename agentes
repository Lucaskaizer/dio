import sqlite3


def init_db():
    conn = sqlite3.connect(":memory:")
    cursor = conn.cursor()
    cursor.execute("CREATE TABLE users (id INTEGER PRIMARY KEY, username TEXT, password TEXT)")
    cursor.execute("INSERT INTO users (username, password) VALUES ('admin', 'S3nh@Sup3rS3cr3t@')")
    conn.commit()
    return conn


# ==============================================================================
# ETAPA 2: Código Vulnerável a SQL Injection (CWE-89) — Usado apenas para teste
# ==============================================================================
def login_vulneravel(conn, username, password):
    cursor = conn.cursor()
    # FALHA: Concatenação direta permite bypass com "' OR '1'='1"
    query = f"SELECT * FROM users WHERE username = '{username}' AND password = '{password}'"
    cursor.execute(query)
    return cursor.fetchone()


# ==============================================================================
# ETAPA 3: Código Corrigido (Consulta Parametrizada / Prepared Statement)
# ==============================================================================
def login_seguro(conn, username, password):
    cursor = conn.cursor()
    # CORREÇÃO: Uso de placeholders (?) impede que a entrada altere a estrutura SQL
    query = "SELECT * FROM users WHERE username = ? AND password = ?"
    cursor.execute(query, (username, password))
    return cursor.fetchone()


if __name__ == "__main__":
    db = init_db()

    print("--- Teste com Credenciais Inválidas / Tentativa de SQLi ---")
    payload_malicioso = "' OR '1'='1"
    print("Resultado Login Seguro:", login_seguro(db, "admin", payload_malicioso))

    print("\n--- Teste com Credenciais Válidas ---")
    print("Resultado Login Seguro:", login_seguro(db, "admin", "S3nh@Sup3rS3cr3t@"))
EOF

